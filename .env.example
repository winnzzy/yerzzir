# Yerzzir Store backend environment variables. Copy this file to .env
# for local testing only. On Vercel, set these in the project dashboard
# under Settings, Environment Variables. Never commit real values.

# Postgres connection string. Works with Supabase (use its pooled
# transaction mode connection string) or Neon (use its pooled string).
DATABASE_URL=

# Set to false only for a local Postgres without SSL. Leave unset for
# Supabase and Neon, which require SSL.
DATABASE_SSL=

# Shared token for the admin list, status update, and chat reply routes.
# Sent as the x-admin-token header. When unset, admin routes are disabled.
ADMIN_TOKEN=

# Flutterwave secret key, used only server side to verify transactions.
# Must arrive through the Secure Vault, never chat. Never put it in
# front end code.
FLUTTERWAVE_SECRET_KEY=

# Flutterwave webhook secret hash, compared against the verif-hash
# header on every webhook call. Must arrive through the Secure Vault.
FLUTTERWAVE_WEBHOOK_SECRET=

# Resend API key for order and abandoned cart emails.
RESEND_API_KEY=

# Domain verified in Resend. Store emails are sent from orders@ on this
# domain.
EMAIL_FROM_DOMAIN=

# Public base URL of the deployed store, used for track and shop links
# in emails. Optional. When empty, emails omit the link and name the page.
STORE_URL=

# WhatsApp Cloud API verification token for webhook setup.
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Cloud API access token. Set only when WhatsApp replies are live.
WHATSAPP_TOKEN=

# WhatsApp Cloud API phone number id for the store number.
WHATSAPP_PHONE_NUMBER_ID=

# Shared secret for the Vercel Cron reminders route. Vercel sends it as
# a Bearer token with every cron call when it is set.
CRON_SECRET=
